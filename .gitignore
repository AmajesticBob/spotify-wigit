# ==========================================
# Xcode & Apple Developer Tools
# ==========================================
# Build products & intermediate files
build/
DerivedData/
*.moved-aside

# User-specific Xcode state (window positions, open tabs, personal breakpoints)
*.xcuserstate
*.xcuserdatad
xcuserdata/
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcscmblueprint
*.xccheckout
*.xcbkptlist

# Legacy Xcode settings
*.mode1v3
*.mode2v3
*.perspectivev3
!default.mode1v3
!default.mode2v3
!default.perspectivev3

# Code signing & provisioning (do not commit sensitive certificates or provisioning profiles)
*.cer
*.cert
*.p12
*.pfx
*.mobileprovision
*.provisionprofile

# ==========================================
# Swift Package Manager (SPM)
# ==========================================
.build/
.swiftpm/
Packages/

# ==========================================
# Development & Editor Temporary Files
# ==========================================
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains / AppCode
.idea/

# Vim / Emacs
*~
*.swp
*.swo
.#*
\#*\#

# Logs & Environment
*.log
.env
.env.*
!.env.example

# Antigravity & Agent Caches
.agents/
.cache/
scratch/
